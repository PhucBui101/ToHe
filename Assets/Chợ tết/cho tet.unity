  m_Script: {fileID: 11500000, guid: 5ec57afdca660a849812d53c9044de87, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data:
    npcName: "Anh b\xE1n hoa"
    talkLines:
    - "Mua hoa T\u1EBFt v\u1EC1 ch\u01B0ng kh\xF4ng \u1EA1!!?? Nay 30 \xE2m em x\u1EA3
      l\u1ED7 mua 2 t\u1EB7ng 2 !!!"
    - "Anh mua hoa \xE0 anh?"
    - "Anh \u01B0ng m\u1EABu n\xE0o? N\xF3i \u0111i em l\u1EA5y cho xem."
    question: "M\xECnh n\xEAn mua hoa g\xEC nh\u1EC9?"
    answers:
    - Hoa mai
    - "Hoa \u0111\xE0o"
    - "Hoa d\xE2m b\u1EE5t"
    - "Hoa h\u1ED3ng"
    correctIndex: 1
    postWinLine: "B\u1EA1n t\xEDnh mua nh\u01B0ng kh\xF4ng mang ti\u1EC1n n\xEAn
      \u0111\xE3 b\u1ECF l\u1EA1i."
    rewardItem: {fileID: 0}
    winLine: "Th\xF4i c\u0169ng \u0111\u01B0\u1EE3c !"
    loseLine: "Hoa \u0111\u1EA5y em h\u1EBFt r\u1ED3i anh zai \u1EA1 haha"
  hasWon: 0
