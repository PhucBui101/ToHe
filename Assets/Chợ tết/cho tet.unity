--- !u!114 &1953769151
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1953769147}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5ec57afdca660a849812d53c9044de87, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data:
    npcName: "\xD4ng \u0111\u1ED3"
    talkLines:
    - "C\u1EADu mu\u1ED1n xin ch\u1EEF \xE0?"
    - "N\u1EBFu c\u1EADu mu\u1ED1n xin m\u1EF1c th\xEC ta kh\xF4ng th\u1EC3."
    - "Nh\u01B0ng n\u1EBFu c\u1EADu mu\u1ED1n, ta c\xF3 th\u1EC3 cho c\u1EADu m\u1ED9t
      th\u1EE9 gi\u1ED1ng v\u1EADy."
    - "C\u1EADu h\xE3y \u0111o\xE1n xem. M\u1ED9t th\u1EE9 v\u1EABn c\xF2n non xanh,
      nh\u01B0ng \u0111\u1EE7 \u0111\u1EC3 h\xFAt c\u1EADu v\xE0o trong nh\u01B0
      \u0111\xEAm canh ba."
    question: "Theo \xFD th\u1EA7y \u0111\u1ED3, \u0111\xF3 l\xE0 g\xEC?"
    answers:
    - "Ch\xEC than"
    - "Thu\u1ED1c nhu\u1ED9m \u0111en"
    - "L\xE1 nh\u1ECD n\u1ED3i"
    - "Nh\u1EF1a c\xE2y s\u01A1n"
    correctIndex: 2
    postWinLine: "B\u1EA1n \u0111\xE3 nh\u1EADn \u0111\u01B0\u1EE3c v\u1EADt ph\u1EA9m:
      L\xE1 nh\u1ECD n\u1ED3i."
    rewardItem: {fileID: 0}
    winLine: "Ch\xFAc m\u1EEBng ch\xE0ng trai! Cho ta g\u1EEDi l\u1EDDi th\u0103m
      \u0111\u1EBFn c\u1EE5 L\xFD nh\xE9!"
    loseLine: "H\xE3y suy ng\u1EABm cho k\u0129, v\xE0 th\u1EED l\u1EA1i n\xE0o."
  hasWon: 0
