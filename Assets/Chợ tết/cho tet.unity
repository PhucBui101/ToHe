--- !u!114 &340162863
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 340162859}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5ec57afdca660a849812d53c9044de87, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data:
    npcName: "Ch\u1ECB b\xE1n tr\xE1i c\xE2y"
    talkLines:
    - "Tr\xE1i c\xE2y t\u01B0\u01A1i \u0111\xE2y !! Mua v\u1EC1 c\xFAng qu\u1EA3
      \u0111i \u1EA1!!."
    - "Ch\xE1u mua m\u1EA5y c\xE2n?\t."
    - "H\xF4m nay c\xF4 m\u1EDBi nh\u1EADp 1 r\u1ED5 qu\u1EA3 \u0111\u1EB7c bi\u1EC7t."
    - "Ch\xE1u tr\u1EA3 l\u1EDDi \u0111\u01B0\u1EE3c c\xE2u \u0111\u1ED1 n\xE0y,
      c\xF4 cho ch\xE1u t\u1EA5t lu\xF4n."
    question: "Qu\u1EA3 g\xEC ch\xEDn \u0111\u1ECF, v\u1ECF c\xF3 nhi\u1EC1u gai,
      ru\u1ED9t \u0111em \u0111\u1ED3 x\xF4i, \u0103n v\xE0o s\xE1ng m\u1EAFt?"
    answers:
    - "Qu\u1EA3 t\xE1o"
    - "Qu\u1EA3 d\u01B0a h\u1EA5u"
    - "Qu\u1EA3 cam"
    - "Qu\u1EA3 g\u1EA5c"
    correctIndex: 3
    postWinLine: "B\u1EA1n \u0111\xE3 nh\u1EADn \u0111\u01B0\u1EE3c v\u1EADt ph\u1EA9m:
      Qu\u1EA3 g\u1EA5c"
    rewardItem: {fileID: 0}
    winLine: "Haha th\xF4i c\xF4 bi\u1EBFu qu\xE0 t\u1EB7ng \xF4ng. Ch\xFAc m\u1EEBng
      n\u0103m m\u1EDBi ch\xE1u nh\xE9!"
    loseLine: "Haha c\xF4 \u0111\xE0nh ph\u1EA3i t\u1EB7ng ng\u01B0\u1EDDi kh\xE1c
      r\u1ED3i!"
  hasWon: 0
