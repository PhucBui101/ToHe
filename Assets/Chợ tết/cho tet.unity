--- !u!114 &163080484
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 163080481}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5ec57afdca660a849812d53c9044de87, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data:
    npcName: "Th\u1EA7y lang"
    talkLines:
    - "T\u1EBFt n\u0103m nay v\u1EC1 mu\u1ED9n th\u1EBF ch\xE1u c\u1EE5 L\xFD?"
    - "c\u1EE5 L\xFD d\u1EA1o n\xE0y th\u1EBF n\xE0o r\u1ED3i?."
    - "Haha c\u1EE5 L\xFD l\xE0 b\u1EA1n th\xE2n c\u1EE7a ta th\u1EDDi c\xF2n \u1EDF
      tr\u01B0\u1EDDng Ph\xE1p"
    - "Ta t\u1EB7ng ch\xE1u l\xE1 thu\u1ED1c qu\xFD n\xE0y, nh\u01B0ng ch\u1EC9 khi
      ta th\u1EED ki\u1EBFn th\u1EE9c c\u1EE7a d\xE2n th\xE0nh ph\u1ED1 \u0111\xE3
      haha!"
    question: "L\xE1 nh\u1ECF xanh um, nhu\u1ED9m m\xE0u tr\u1EDDi \u0111\xEAm, T\u1EEBng
      ch\xF9m l\xE1 m\u1ECDc, \xE1o ch\xE0m th\u1EADt xinh?"
    answers:
    - "Ng\u1EA3i c\u1EE9u"
    - "T\xEDa t\xF4"
    - "s\xE2m Ng\u1ECDc Linh"
    - "L\xE1 ch\xE0m"
    correctIndex: 3
    postWinLine: "B\u1EA1n \u0111\xE3 nh\u1EADn \u0111\u01B0\u1EE3c v\u1EADt ph\u1EA9m:
      L\xE1 ch\xE0m"
    rewardItem: {fileID: 0}
    winLine: "Ta bi\u1EBFu c\u1EE5 L\xFD. N\u0103m m\u1EDBi r\xE1ng h\u1ECDc gi\u1ECFi
      ch\xE1u nh\xE9!"
    loseLine: "Mu\u1ED1n th\xE0nh t\xE0i ph\u1EA3i tr\u1EA3i nghi\u1EC7m nhi\u1EC1u.
      Mu\u1ED1n gi\u1EA3i \u0111\u01B0\u1EE3c c\xE2u \u0111\u1ED1 c\u1EE7a ta kh\xF4ng
      d\u1EC5."
  hasWon: 0
