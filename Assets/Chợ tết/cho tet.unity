--- !u!114 &2042138874
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2042138873}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5ec57afdca660a849812d53c9044de87, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data:
    npcName: "ch\u1ECB b\xE1n rau c\u1EE7"
    talkLines:
    - "\xD4i ch\xE1u c\u1EE5 L\xFD \u0111\xE2y m\xE0!."
    - "L\xE2u qu\xE1 c\xF4 kh\xF4ng g\u1EB7p m\xE0y."
    - "L\xEAn th\xE0nh ph\u1ED1 xong tr\xF4ng m\xE0y b\u1EE5 b\u1EABm h\u1EB3n \u0111\u1EA5y
      con \u1EA1 haha!."
    - "C\u1EE5 L\xFD c\xF3 kh\u1ECFe kh\xF4ng? Th\xF4i cho c\xF4 m\xE0y bi\u1EBFu
      c\u1EE5 qu\xE0 T\u1EBFt nh\xE9!"
    - "L\xEAn th\xE0nh ph\u1ED1 r\u1ED3i c\xF3 bi\u1EBFt c\u1EE7 n\xE0y l\xE0 c\u1EE7
      g\xEC kh\xF4ng?"
    question: "C\u1EE7 g\xEC m\xE0u v\xE0ng, v\u1ECF m\u1ECFng, hay d\xF9ng l\xE0m
      gia v\u1ECB v\xE0 ch\u1EEFa \u0111au d\u1EA1 d\xE0y?"
    answers:
    - "C\u1EE7 c\u1EA3i"
    - "C\u1EE7 c\xE0 r\u1ED1t"
    - "C\u1EE7 ngh\u1EC7"
    - "C\u1EE7 khoai t\xE2y"
    correctIndex: 2
    postWinLine: "B\u1EA1n \u0111\xE3 nh\u1EADn \u0111\u01B0\u1EE3c v\u1EADt ph\u1EA9m:
      C\u1EE7 ngh\u1EC7"
    rewardItem: {fileID: 0}
    winLine: "M\xE0y gi\u1ECFi \u0111\u1EA5y cu \u1EA1 haha, \u0111\xE2y c\xF4 cho
      n\xE0y!"
    loseLine: "Ti\u1EBFc qu\xE1 \u0111i haha!"
  hasWon: 0
