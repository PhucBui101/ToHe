--- !u!114 &2079633525
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2079633522}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5ec57afdca660a849812d53c9044de87, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data:
    npcName: "Anh b\xE1n g\u1EA1o"
    talkLines:
    - "G\u1EA1o ngon \u0111\xE2y !!! G\u1EA1o th\u01A1m d\u1EBBo \u0111\xE2y !!!"
    - "\xD4 em zai nh\xE0 c\u1EE5 L\xFD, m\u1EDBi t\u1EEB ph\u1ED1 v\u1EC1 \u0111\u1EA5y
      \xE0 em?"
    - "Nh\xECn m\xE0y \u1ED1m \u0111\xF3i qu\xE1 v\u1EADy, \u0111i h\u1ECDc r\u1EDBt
      m\xF4n n\xEAn ph\u1EA3i \u0111\u1EDBp m\xEC \xE0?"
    - "Th\xF4i gi\u1EDD anh \u0111\u1ED1 m\xE0y c\xE1i n\xE0y, m\xE0y tr\u1EA3 l\u1EDDi
      \u0111\u01B0\u1EE3c anh cho m\xE0y n\u1EAFm g\u1EA1o h\u1ED1c c\u1EA7m h\u01A1i
      em \u1EA1"
    question: "G\u1EA1o g\xEC d\xEDnh d\xEDnh, d\u1EBBo d\u1EBBo, h\u1EA5p l\xEAn
      l\xE0m x\xF4i l\xE0m qu\xE0 \u0111\u01B0\u1EE3c?"
    answers:
    - "G\u1EA1o n\u1EBFp"
    - "G\u1EA1o ST25"
    - "G\u1EA1o c\u1ED9i"
    - "G\u1EA1o l\u1EE9t"
    correctIndex: 0
    postWinLine: "B\u1EA1n \u0111\xE3 nh\u1EADn \u0111\u01B0\u1EE3c v\u1EADt ph\u1EA9m:
      G\u1EA1o n\u1EBFp"
    rewardItem: {fileID: 0}
    winLine: "Kinh th\u1EADt, cho m\xE0y n\u1EAFm g\u1EA1o n\u1EBFp n\xE0y em"
    loseLine: "Ch\u01B0a \u0111\u1EE7 tr\xECnh \u0111\xE2u em \u1EA1, \u0111\u1EDBp
      m\xEC t\xF4m ti\u1EBFp \u0111i em haha"
  hasWon: 0
